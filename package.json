{
  "name": "production-quality-engineering",
  "version": "1.0.0",
  "description": "Multi-layer quality engineering framework covering UI, API, database, accessibility, visual, mobile and network validation.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate": "npm run lint && npm run typecheck && playwright test --project=ui-chromium tests/ui/har-replay.spec.ts",
    "test": "playwright test",
    "test:ui": "playwright test --project=ui-chromium",
    "test:ui:smoke": "playwright test --project=ui-chromium --grep @Smoke",
    "test:ui:cross-browser": "playwright test --project=ui-chromium --project=ui-firefox --project=ui-webkit",
    "test:ui:har:record": "node tests/ui/har/record.js",
    "test:api": "playwright test --project=api",
    "test:db": "node db/seed.js && playwright test --project=db",
    "test:a11y": "playwright test --project=accessibility",
    "test:visual": "playwright test --project=visual",
    "test:mobile": "playwright test --project=mobile",
    "report:allure": "allure serve allure-results"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "allure-playwright": "^3.8.0",
    "dotenv": "^16.4.5",
    "pdfjs-dist-es5": "^2.13.216",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^9.39.2",
    "typescript": "^6.0.3"
  }
}
